ORIGIN=http://127.0.0.1:3000
AFTERWORD_PUBLIC_URL=http://127.0.0.1:3000
BIND_ADDRESS=127.0.0.1
# Set this to bootstrap the first administrator automatically, or migrate the old Basic-auth account.
# If left blank, the first person to complete setup at /login becomes administrator.
# Keep the service bound to localhost until setup is complete.
AFTERWORD_AUTH_USERNAME=bookward
AFTERWORD_AUTH_PASSWORD=
# Generate a private random value shared only by the web and engine containers.
ENGINE_SERVICE_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_AUTO_PROVISION=false
# Redirect unauthenticated users straight to OIDC when the provider is configured.
OIDC_AUTO_LOGIN=false
ENGINE_URL=http://127.0.0.1:8000
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=hashing-768
EMBEDDING_URL=http://ollama:11434
EMBEDDING_API_KEY=
# Default permanent-source polling cadence in hours (also configurable in Sources).
SOURCE_SYNC_INTERVAL_HOURS=24
# Optional Fernet key. If omitted, the engine creates /data/secret.key automatically.
AFTERWORD_SECRET_KEY=
# Engine snapshots use SQLite's online backup API and the separate backup volume by default.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=7
# Optional alternate directory, mounted persistently into the engine container.
BACKUP_DIR=
# Comma-separated private service names that may receive the Librarr API key.
LIBRARR_ALLOWED_HOSTS=librarr
